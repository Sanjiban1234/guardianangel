<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Default: HTTPS-only for production -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Allow cleartext HTTP for React Native Metro dev server (debug builds only via manifest placeholder) -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain>10.0.2.2</domain>
        <domain>10.0.3.2</domain>
    </domain-config>

    <!-- Production HTTPS domains -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">railway.app</domain>
        <domain includeSubdomains="true">up.railway.app</domain>
        <domain includeSubdomains="true">supabase.co</domain>
    </domain-config>
</network-security-config>
