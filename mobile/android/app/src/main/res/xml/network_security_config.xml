<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Trust Railway and other production HTTPS domains -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <!-- Trust system certificates (includes Let's Encrypt used by Railway) -->
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Allow all domains for development/testing -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">railway.app</domain>
        <domain includeSubdomains="true">up.railway.app</domain>
        <domain includeSubdomains="true">supabase.co</domain>
    </domain-config>
</network-security-config>
