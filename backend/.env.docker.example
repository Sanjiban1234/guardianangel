# Docker environment variables
# Copy this to .env.docker and update values for your environment

# Database (REQUIRED)
POSTGRES_DB=guardian_angel
POSTGRES_USER=ga_admin
POSTGRES_PASSWORD=CHANGE_ME

# JWT Secret (REQUIRED - change for production)
JWT_SECRET=CHANGE_ME

# Optional: Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:19006

# Optional: Override default port (default: 3000)
# PORT=3000

# Optional: Max body size for requests (default: 100kb)
# MAX_BODY_SIZE=100kb

# Optional: Max bulk telemetry batch size (default: 100)
# MAX_BULK_BATCH=100

# Route recommendation providers (configured separately in production)
GOOGLE_MAPS_API_KEY=
DEEPSEEK_API_KEY=
